# Local development defaults
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Africa/Johannesburg

# Leave blank to use db.sqlite3. PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/careergps
DATABASE_URL=
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=False

# Personalized feed v2 remains shadow-only until its worker is deployed and
# `manage.py verify_v2_feed --strict` passes.
CAREERGPS_FEED_READ_VERSION=legacy
CAREERGPS_V2_WORKER_SCHEDULED=False
CAREERGPS_V2_TASK_MAX_ATTEMPTS=3
CAREERGPS_V2_TASK_LEASE_SECONDS=900

# Gemini
# Primary/default key:
GEMINI_API_KEY=
# Fallback key used when the primary hits quota/auth/transient provider failures:
GEMuINI_API_KEY=
# Shared runtime gateway uses OpenAI after eligible Gemini failures.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Interview and document fallback only; Application Job Search never uses Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Explicit/manual opportunity extraction and separate processing export/import:
OPPORTUNITY_AI_MODEL=gemini-3.5-flash
OPPORTUNITY_AI_THINKING_LEVEL=medium
# Increment these only when the extraction contract/prompt changes.
OPPORTUNITY_AI_SCHEMA_VERSION=2.4.2
OPPORTUNITY_AI_PROMPT_VERSION=2.4.5

# The AI gateway receives opportunity identity only (title, employer and location if known).
APPLICATION_JOB_SEARCH_MODEL=gemini-3.5-flash
APPLICATION_JOB_SEARCH_THINKING_LEVEL=low
APPLICATION_JOB_SEARCH_TIMEOUT_SECONDS=90
APPLICATION_JOB_SEARCH_RETRY_MINUTES=360

# Controlled CV and cover-letter wording
DOCUMENT_AI_MODEL=gemini-3.5-flash
DOCUMENT_AI_THINKING_LEVEL=low
DOCUMENT_AI_TIMEOUT_SECONDS=90

# Phase 3 spoken interview transcription. Pre-cache the model during setup or
# set INTERVIEW_WHISPER_MODEL_PATH to a local faster-whisper model directory.
INTERVIEW_WHISPER_MODEL=base.en
INTERVIEW_WHISPER_MODEL_PATH=
INTERVIEW_WHISPER_DEVICE=cpu
INTERVIEW_WHISPER_COMPUTE_TYPE=int8
INTERVIEW_WHISPER_LOCAL_FILES_ONLY=True

# Open-source semantic relevance helper
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
# Run manage.py prepare_semantic_model before starting document workers.
# Relative paths resolve from the Django project root. Keep custom paths outside Git.
SENTENCE_TRANSFORMER_LOCAL_PATH=.local_models/semantic
# Load once in each serving process before accepting requests.
SENTENCE_TRANSFORMER_WARMUP_ON_START=True
# Optional setup-only Hugging Face authentication; never needed at request time.
HF_TOKEN=



# Source access policy
INGESTION_USER_AGENT=CareerGPSOpportunityBot/1.0 (+https://your-domain.example; contact: careers@example.com)
INGESTION_TIMEOUT_SECONDS=20
INGESTION_REQUEST_DELAY_SECONDS=1.0
INGESTION_MISSING_GRACE_DAYS=7

# Optional SMTP delivery
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="CareerGPS <rabidziwamonanku@gmail.com>"

# Public legal/operator details. Supply verified owner facts before production.
# These are not the identity details of an employer using CareerGPS.
CAREERGPS_OPERATOR_NAME=
CAREERGPS_OPERATOR_LEGAL_STATUS=
CAREERGPS_OPERATOR_REGISTRATION_NUMBER=
CAREERGPS_OPERATOR_PHYSICAL_ADDRESS=
CAREERGPS_OPERATOR_LEGAL_SERVICE_ADDRESS=
CAREERGPS_OPERATOR_TELEPHONE=
CAREERGPS_CONTACT_EMAIL=
CAREERGPS_PRIVACY_EMAIL=
CAREERGPS_INFORMATION_OFFICER=

# Production HTTPS policy
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

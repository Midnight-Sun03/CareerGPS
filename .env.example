# ── CareerGPS Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Django secret key — generate one at: https://djecrety.ir/
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts (add your domain in production)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Gemini API ────────────────────────────────────────────────────────────────
